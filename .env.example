AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6   (Anthropic default)
# AGENT_LLM_MODEL=gemini-3.1-pro       (Gemini default)

# Set exactly ONE provider key (this project uses Gemini):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

PORT=8001

# --- Data-analysis-agent settings ---
# Local storage root for uploaded/derived datasets
AGENT_DATA_DIR=./data
# Reject uploads above this size (MB)
AGENT_MAX_UPLOAD_MB=100
# Sandbox subprocess wall-clock limit (seconds)
AGENT_SANDBOX_TIMEOUT_SECONDS=20
# Raw-row privacy boundary caps — the LLM never sees more than this many rows/items
AGENT_MAX_SUMMARY_ROWS=20
AGENT_MAX_SUMMARY_ITEMS=50
# Iterative-refinement step limit (Phase 1 = 1, Phase 2 raises this)
AGENT_MAX_STEPS=1
# Gemini per-token cost estimation (USD per 1M tokens) — adjust to current pricing
AGENT_GEMINI_INPUT_PRICE_PER_1M=1.25
AGENT_GEMINI_OUTPUT_PRICE_PER_1M=5.00

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
